<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Stat Mystery Mode</title>
<style>
/* ============================
   STAT MYSTERY MODE STYLES
   ============================ */

body {
  background: #111;
  font-family: Arial, sans-serif;
  color: white;
  text-align: center;
}

.container {
  max-width: 600px;
  margin: auto;
  padding-top: 40px;
}

.title {
  font-size: 42px;
  font-weight: bold;
  color: gold;
  margin-bottom: 20px;
}

.clue-box {
  background: #222;
  color: white;
  padding: 20px;
  border: 2px solid gold;
  border-radius: 10px;
  margin-bottom: 20px;
  font-size: 22px;
}

.guess-input {
  width: 80%;
  padding: 12px;
  font-size: 20px;
  border-radius: 8px;
  border: 2px solid gold;
  margin-bottom: 10px;
}

.submit-btn, .new-btn {
  background: gold;
  color: black;
  padding: 12px 20px;
  font-size: 20px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  margin: 10px;
}

.submit-btn:hover, .new-btn:hover {
  background: #e6c200;
}

.result {
  font-size: 24px;
  margin-top: 15px;
  color: white;
}

.mode-selector button {
  padding: 10px 20px;
  margin: 10px;
  font-size: 18px;
  border-radius: 8px;
  border: 2px solid gold;
  background: black;
  color: gold;
  cursor: pointer;
}

.mode-selector .active {
  background: gold;
  color: black;
}
</style>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <div class="container">
    <h1 class="title">Stat Mystery Mode</h1>

    <div class="mode-selector">
      <button id="nflBtn" class="active">NFL</button>
    </div>

    <div id="clueBox" class="clue-box">Press "New Player" to begin</div>

    <input id="guessInput" class="guess-input" placeholder="Enter player name...">
    <button id="submitGuess" class="submit-btn">Submit Guess</button>

    <div id="result" class="result"></div>

    <button id="newPlayer" class="new-btn">New Player</button>
  </div>

  <script src="statmystery.js"></script>
</body>
</html>
